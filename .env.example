# Copy file này thành .env rồi dán key thật vào. KHÔNG commit .env.
# Giọng đọc thuyết minh (TTS chính, Sếp 11/11): API key tts.vclip.io (trang Cài đặt → API keys).
# Giọng từng shop = shop.json voice.vclip (id lấy bằng: .venv\Scripts\python.exe tools\vclip_voices.py)
VCLIP_API_KEY=
# TTS dự phòng khi vclip lỗi: tokenrouter.com (openai/gpt-audio-mini). Để trống = không dự phòng.
TOKENROUTER_API_KEY=
# Soát ảnh (qa, vs.py look) qua Codex CLI đăng nhập ChatGPT — model rẻ; trống = gpt-5.6-luna. CODEX_DISABLE=1 → chỉ Gemini.
CODEX_MODEL=
GEMINI_API_KEY=
# Model Gemini dùng để phân tích video / đọc khung hình (đổi khi Google ra bản mới)
GEMINI_MODEL=gemini-3-flash-preview
# Để trống = tự tìm ffmpeg/ffprobe trên PATH hoặc thư mục WinGet\Links
FFMPEG_PATH=
FFPROBE_PATH=
